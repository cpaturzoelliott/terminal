<UserControl x:Class="TerminalApp.CommandHistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Width="340"
             Visibility="Collapsed"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Drag this edge to make the widget wider or narrower. -->
        <Border Grid.Column="0"
                Width="4"
                Background="Transparent"
                AutomationProperties.Name="Resize command history"
                PointerCaptureLost="_ResizePointerReleased"
                PointerMoved="_ResizePointerMoved"
                PointerPressed="_ResizePointerPressed"
                PointerReleased="_ResizePointerReleased" />

        <Border Grid.Column="1"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="12,8,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Uid="CommandHistoryTitle"
                               Text="Command history"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            AutomationProperties.Name="Refresh command history"
                            ToolTipService.ToolTip="Refresh"
                            Click="_RefreshClick">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="14"
                                  Glyph="&#xE72C;" />
                    </Button>

                    <Button Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            AutomationProperties.Name="Close command history"
                            ToolTipService.ToolTip="Close"
                            Click="_CloseClick">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="14"
                                  Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <TextBox x:Name="SearchBox"
                         x:Uid="CommandHistorySearch"
                         Grid.Row="1"
                         Margin="12,0,12,8"
                         PlaceholderText="Search history"
                         TextChanged="_SearchTextChanged" />

                <!-- The filters all sit on one line to keep the list tall. -->
                <Grid Grid.Row="2"
                      Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="HideDuplicatesCheckBox"
                              x:Uid="CommandHistoryHideDuplicates"
                              Grid.Column="0"
                              MinWidth="0"
                              VerticalAlignment="Center"
                              Content="Duplicates"
                              Checked="_FilterChanged"
                              Unchecked="_FilterChanged" />

                    <CheckBox x:Name="GroupCheckBox"
                              x:Uid="CommandHistoryGroup"
                              Grid.Column="1"
                              MinWidth="0"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              Content="Group"
                              Checked="_GroupChanged"
                              Unchecked="_GroupChanged" />

                    <Button Grid.Column="2"
                            Width="24"
                            Height="24"
                            Margin="2,0,0,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Expand all groups"
                            ToolTipService.ToolTip="Expand all"
                            Click="_ExpandAllClick">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="10"
                                  Glyph="&#xE70D;" />
                    </Button>

                    <Button Grid.Column="3"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Collapse all groups"
                            ToolTipService.ToolTip="Collapse all"
                            Click="_CollapseAllClick">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="10"
                                  Glyph="&#xE70E;" />
                    </Button>

                    <ComboBox x:Name="SortComboBox"
                              Grid.Column="4"
                              MinWidth="0"
                              Margin="4,0,0,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"
                              SelectedIndex="0"
                              SelectionChanged="_SortChanged">
                        <ComboBoxItem x:Uid="CommandHistorySortLastUsed"
                                      Content="Recent" />
                        <ComboBoxItem x:Uid="CommandHistorySortAlphabetical"
                                      Content="A-Z" />
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="3">
                    <ListView x:Name="CommandHistoryListView"
                              Padding="4,0,4,8"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="None"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Command history entries">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <!-- The entries contain selectable text, which takes the pointer events
                                     for itself, so the entry paints its own hover state. -->
                                <Grid Background="Transparent"
                                      PointerEntered="_EntryPointerEntered"
                                      PointerExited="_EntryPointerExited">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            IsHitTestVisible="False"
                                            Opacity="0" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding}"
                                                   Margin="8,6,4,6"
                                                   FontFamily="Cascadia Mono"
                                                   FontSize="12"
                                                   IsTextSelectionEnabled="True"
                                                   TextWrapping="Wrap" />

                                        <Button Grid.Column="1"
                                                Width="24"
                                                Height="24"
                                                Margin="0,0,4,0"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Remove from command history"
                                                ToolTipService.ToolTip="Remove from the list"
                                                Click="_RemoveClick">
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                      FontSize="10"
                                                      Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="CommandHistoryEmptyText"
                               x:Uid="CommandHistoryEmpty"
                               Text="No commands yet"
                               Margin="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsHitTestVisible="False"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <TextBlock x:Name="CommandHistoryNoMatchesText"
                               x:Uid="CommandHistoryNoMatches"
                               Text="No matching commands"
                               Margin="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsHitTestVisible="False"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
